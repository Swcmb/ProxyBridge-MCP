{
  "name": "proxybridge-mcp",
  "private": true,
  "version": "0.1.0",
  "description": "MCP Server for ProxyBridge CLI",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "npm --prefix packages/mcp-server run build",
    "start": "node packages/mcp-server/dist/index.js",
    "test": "npm --prefix packages/mcp-server run test",
    "lint": "npm --prefix packages/mcp-server run lint",
    "bench:startup": "node packages/mcp-server/node_modules/tsx/dist/cli.mjs scripts/bench-startup.ts",
    "check:license": "node packages/mcp-server/node_modules/tsx/dist/cli.mjs scripts/check-license.ts",
    "check:tools": "node packages/mcp-server/node_modules/tsx/dist/cli.mjs scripts/check-tools.ts",
    "check:no-shell": "node packages/mcp-server/node_modules/tsx/dist/cli.mjs scripts/check-no-shell.ts",
    "check:skill-refs": "node packages/mcp-server/node_modules/tsx/dist/cli.mjs scripts/check-skill-refs.ts"
  }
}
